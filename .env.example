# ==========================================
# ATTAYA BEAUTY LUXE BLORA - ENVIRONMENT CONFIG
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI Concierge API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public production app URL
APP_URL="https://attayaluxe.com"

# MIDTRANS PAYMENT GATEWAY CONFIG (PRODUCTION & SANDBOX)
MIDTRANS_SERVER_KEY="SB-Mid-server-XXXXX"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YYYYY"
MIDTRANS_MERCHANT_ID="G123456789"
MIDTRANS_IS_PRODUCTION=false

# FIREBASE CONFIGURATION (PERSISTENCE & AUTH)
VITE_FIREBASE_API_KEY="AIzaSyXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="attaya-beauty-luxe.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="attaya-beauty-luxe"
VITE_FIREBASE_STORAGE_BUCKET="attaya-beauty-luxe.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"

# CONTAINER & PORT CONFIG
PORT=3000
NODE_ENV=production

# OPTIONAL: Docker deployment metadata
DOCKER_IMAGE_NAME="attaya-beauty-luxe"
DOCKER_CONTAINER_NAME="attaya_beauty_luxe_app"
